# Copy to .env and adjust as needed.

# Default is a local SQLite file (zero setup). For PostgreSQL (TECH-STACK.md):
# DATABASE_URL=postgresql+psycopg2://signetix:signetix@localhost:5432/signetix

# Confidence (0-1) at which a gloss counts as correctly signed in practice mode.
GLOSS_PASS_THRESHOLD=0.80

# Comma-separated allowed origins for CORS ("*" for local dev).
CORS_ORIGINS=*
